# Example participant 001 credentials. Leave blank until you create a local .env file.
GOOGLE_EXAMPLE_001_CLIENT_ID=
GOOGLE_EXAMPLE_001_CLIENT_SECRET=
GOOGLE_EXAMPLE_001_REFRESH_TOKEN=

# Optional: override Google Health API data type ids if your project uses different names.
GOOGLE_EXAMPLE_001_STEPS_DATA_TYPE=steps
GOOGLE_EXAMPLE_001_HEART_RATE_DATA_TYPES=heart-rate,heart_rate,heartRate,heart_rate_bpm
GOOGLE_EXAMPLE_001_SLEEP_DATA_TYPES=sleep,sleep_session,sleepSession

# Optional: separate credentials for additional example participants.
GOOGLE_EXAMPLE_002_CLIENT_ID=
GOOGLE_EXAMPLE_002_CLIENT_SECRET=
GOOGLE_EXAMPLE_002_REFRESH_TOKEN=
GOOGLE_EXAMPLE_003_CLIENT_ID=
GOOGLE_EXAMPLE_003_CLIENT_SECRET=
GOOGLE_EXAMPLE_003_REFRESH_TOKEN=
GOOGLE_EXAMPLE_004_CLIENT_ID=
GOOGLE_EXAMPLE_004_CLIENT_SECRET=
GOOGLE_EXAMPLE_004_REFRESH_TOKEN=
GOOGLE_EXAMPLE_005_CLIENT_ID=
GOOGLE_EXAMPLE_005_CLIENT_SECRET=
GOOGLE_EXAMPLE_005_REFRESH_TOKEN=

# Optional: Slack chatbot channel for anomaly questions.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_PARTICIPANT_MAP=config/slack_participants.example.json
SLACK_BOT_ID=example_slack_bot

# Optional: second example workspace used by config/slack_workspaces.example.json.
SLACK_BOT_TOKEN_WORKSPACE_B=
SLACK_APP_TOKEN_WORKSPACE_B=
